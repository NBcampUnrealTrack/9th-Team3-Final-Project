root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl}]
indent_style = tab
indent_size = tab
tab_width = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{md,markdown}]
trim_trailing_whitespace = false
